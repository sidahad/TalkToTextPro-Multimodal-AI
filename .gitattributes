# PUT THIS FILE IN THE REPO ROOT (next to README.md), not inside any folder.
# GitHub only reads the root .gitattributes when it counts languages.

# Hide HTML pages from the language stats (works in any folder, no path needed)
*.html linguist-vendored

# Minified files are generated, not hand-written
*.min.js linguist-generated
*.min.css linguist-generated

# OPTIONAL, Gamaxy only: also hide static assets such as games and libraries.
# Remove the leading # to turn it on. The path starts from the repo root.
# GamaxyWebApplication/wwwroot/** linguist-vendored
